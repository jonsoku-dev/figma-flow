{
  "schema": "little-hands-stylesheet-v1",
  "groups": [
    [
      {
        "selector": "@font-face",
        "declarations": {
          "font-family": "{{fonts.body.family}}",
          "src": "url('fonts/Hahmlet.woff2') format('woff2')",
          "font-style": "normal",
          "font-weight": "100 900",
          "font-display": "swap"
        }
      }
    ],
    [
      {
        "selector": ":root",
        "declarations": {
          "--paper": "{{colors.paper}}",
          "--cream": "{{colors.cream}}",
          "--ink": "{{colors.ink}}",
          "--muted": "{{colors.muted}}",
          "--rust": "{{colors.rust}}",
          "--line": "{{colors.line}}",
          "--tint": "{{colors.tint}}",
          "--green": "{{colors.green}}",
          "--danger": "{{colors.rust}}",
          "--gutter": "{{layout.desktop_gutter}}px",
          "--measure": "{{layout.content_max_width}}px"
        }
      }
    ],
    [
      {
        "selector": "*",
        "declarations": {
          "box-sizing": "border-box"
        }
      },
      {
        "selector": "html",
        "declarations": {
          "scroll-behavior": "smooth"
        }
      },
      {
        "selector": "body",
        "declarations": {
          "margin": "0",
          "background": "var(--paper)",
          "color": "var(--ink)",
          "font-family": "{{fonts.body.family}},serif",
          "font-size": "{{font_sizes_px.body}}px",
          "line-height": "1.8"
        }
      },
      {
        "selector": "a",
        "declarations": {
          "color": "inherit",
          "text-underline-offset": "5px"
        }
      },
      {
        "selector": "button,input,select,textarea",
        "declarations": {
          "font": "inherit"
        }
      },
      {
        "selector": "button,a,input,select,textarea",
        "declarations": {
          "-webkit-tap-highlight-color": "transparent"
        }
      },
      {
        "selector": "button",
        "declarations": {
          "cursor": "pointer"
        }
      },
      {
        "selector": "button:disabled",
        "declarations": {
          "cursor": "wait",
          "opacity": ".6"
        }
      },
      {
        "selector": "a:hover",
        "declarations": {
          "color": "var(--rust)"
        }
      },
      {
        "selector": ":focus-visible",
        "declarations": {
          "outline": "{{controls.focus_outline}}px solid var(--rust)",
          "outline-offset": "{{controls.focus_offset}}px"
        }
      },
      {
        "selector": "::selection",
        "declarations": {
          "background": "var(--tint)"
        }
      },
      {
        "selector": "h1,h2,h3,p,figure",
        "declarations": {
          "margin": "0"
        }
      },
      {
        "selector": "h1,h2,h3,strong,th",
        "declarations": {
          "font-weight": "{{fonts.display.weight}}"
        }
      },
      {
        "selector": "h1",
        "declarations": {
          "font-size": "{{font_sizes_px.page}}px",
          "line-height": "1.45",
          "letter-spacing": "-1.2px"
        }
      },
      {
        "selector": "h2",
        "declarations": {
          "font-size": "{{font_sizes_px.section}}px",
          "line-height": "1.5",
          "letter-spacing": "-.6px"
        }
      },
      {
        "selector": "h3",
        "declarations": {
          "font-size": "{{font_sizes_px.subsection}}px",
          "line-height": "1.6"
        }
      },
      {
        "selector": "p",
        "declarations": {
          "max-width": "68ch"
        }
      },
      {
        "selector": "img",
        "declarations": {
          "display": "block",
          "max-width": "100%",
          "height": "auto"
        }
      },
      {
        "selector": "small,.small",
        "declarations": {
          "font-size": "{{font_sizes_px.meta}}px"
        }
      },
      {
        "selector": ".muted",
        "declarations": {
          "color": "var(--muted)"
        }
      },
      {
        "selector": ".skip",
        "declarations": {
          "position": "absolute",
          "top": "-100px",
          "left": "16px",
          "z-index": "20",
          "background": "var(--cream)",
          "padding": "{{spacing_px.1}}px"
        }
      },
      {
        "selector": ".skip:focus",
        "declarations": {
          "top": "8px"
        }
      },
      {
        "selector": ".wrap",
        "declarations": {
          "width": "100%",
          "max-width": "var(--measure)",
          "margin": "auto"
        }
      },
      {
        "selector": ".site-header",
        "declarations": {
          "padding": "0 var(--gutter)",
          "border-bottom": "1px solid var(--line)",
          "background": "var(--cream)"
        }
      },
      {
        "selector": ".header-inner",
        "declarations": {
          "min-height": "96px",
          "display": "flex",
          "align-items": "center",
          "justify-content": "space-between",
          "gap": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".brand",
        "declarations": {
          "text-decoration": "none",
          "font-size": "22px",
          "font-weight": "{{fonts.display.weight}}",
          "line-height": "1.5",
          "letter-spacing": "-.5px"
        }
      },
      {
        "selector": ".brand small",
        "declarations": {
          "display": "block",
          "font-size": "{{font_sizes_px.caption}}px",
          "letter-spacing": "1.1px",
          "color": "var(--muted)",
          "font-weight": "{{fonts.body.weight}}"
        }
      },
      {
        "selector": ".nav",
        "declarations": {
          "display": "flex",
          "align-items": "center",
          "gap": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".nav a,.nav button",
        "declarations": {
          "min-height": "{{controls.inline_min_height}}px",
          "display": "inline-flex",
          "align-items": "center",
          "font-size": "{{font_sizes_px.control}}px"
        }
      },
      {
        "selector": ".nav a",
        "declarations": {
          "text-decoration": "none"
        }
      },
      {
        "selector": ".nav [aria-current=page]",
        "declarations": {
          "color": "var(--rust)",
          "box-shadow": "inset 0 -2px var(--rust)"
        }
      },
      {
        "selector": ".nav form",
        "declarations": {
          "margin": "0"
        }
      },
      {
        "selector": ".text-button",
        "declarations": {
          "border": "0",
          "background": "transparent",
          "padding": "0",
          "color": "var(--muted)"
        }
      },
      {
        "selector": ".environment",
        "declarations": {
          "display": "inline-block",
          "font-size": "{{font_sizes_px.caption}}px",
          "border": "1px solid var(--line)",
          "padding": "1px 7px",
          "margin-left": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".page",
        "declarations": {
          "padding": "{{spacing_px.8}}px var(--gutter) {{spacing_px.10}}px",
          "min-height": "65vh"
        }
      },
      {
        "selector": ".page-heading",
        "declarations": {
          "display": "flex",
          "align-items": "flex-end",
          "justify-content": "space-between",
          "gap": "{{spacing_px.4}}px",
          "margin-bottom": "{{spacing_px.6}}px"
        }
      },
      {
        "selector": ".page-heading p",
        "declarations": {
          "margin-top": "{{spacing_px.1}}px",
          "color": "var(--muted)"
        }
      },
      {
        "selector": ".kicker",
        "declarations": {
          "color": "var(--rust)",
          "font-size": "{{font_sizes_px.meta}}px",
          "margin-bottom": "14px"
        }
      },
      {
        "selector": ".hero",
        "declarations": {
          "display": "grid",
          "grid-template-columns": "1fr 1.03fr",
          "gap": "{{spacing_px.8}}px",
          "align-items": "center",
          "padding": "{{spacing_px.0}}px 0 {{spacing_px.8}}px",
          "border-bottom": "1px solid var(--line)",
          "margin-bottom": "{{spacing_px.8}}px"
        }
      },
      {
        "selector": ".hero h1",
        "declarations": {
          "font-size": "{{font_sizes_px.hero}}px",
          "line-height": "1.5",
          "margin-bottom": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".hero p",
        "declarations": {
          "color": "var(--muted)",
          "margin-bottom": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".hero-photo",
        "declarations": {
          "width": "100%",
          "aspect-ratio": "{{image.desktop_aspect_ratio}}",
          "object-fit": "{{image.fit}}",
          "object-position": "{{image.object_position}}"
        }
      },
      {
        "selector": ".photo-caption",
        "declarations": {
          "font-size": "{{font_sizes_px.caption}}px",
          "color": "var(--muted)",
          "margin-top": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".button",
        "declarations": {
          "display": "inline-flex",
          "justify-content": "center",
          "align-items": "center",
          "gap": "{{spacing_px.0}}px",
          "min-height": "{{controls.min_height}}px",
          "padding": "{{controls.vertical_padding}}px {{controls.horizontal_padding}}px",
          "border": "1px solid var(--rust)",
          "background": "var(--rust)",
          "color": "var(--cream)",
          "text-decoration": "none",
          "font-weight": "{{fonts.display.weight}}",
          "font-size": "{{font_sizes_px.control}}px",
          "line-height": "1.6",
          "border-radius": "{{controls.radius}}"
        }
      },
      {
        "selector": ".button:hover",
        "declarations": {
          "background": "{{interactions.primary_hover}}",
          "color": "var(--cream)",
          "border-color": "{{interactions.primary_hover}}"
        }
      },
      {
        "selector": ".button.secondary",
        "declarations": {
          "background": "transparent",
          "color": "var(--ink)",
          "border-color": "var(--line)"
        }
      },
      {
        "selector": ".button.secondary:hover",
        "declarations": {
          "background": "var(--tint)",
          "border-color": "var(--muted)"
        }
      },
      {
        "selector": ".button.quiet",
        "declarations": {
          "background": "var(--cream)",
          "border-color": "var(--line)",
          "color": "var(--ink)"
        }
      },
      {
        "selector": ".button.danger",
        "declarations": {
          "border-color": "var(--rust)",
          "background": "transparent",
          "color": "var(--rust)"
        }
      },
      {
        "selector": ".actions",
        "declarations": {
          "display": "flex",
          "flex-wrap": "wrap",
          "align-items": "center",
          "gap": "{{spacing_px.1}}px",
          "margin-top": "{{spacing_px.5}}px"
        }
      },
      {
        "selector": ".section-heading",
        "declarations": {
          "display": "flex",
          "align-items": "center",
          "justify-content": "space-between",
          "gap": "{{spacing_px.2}}px",
          "margin-bottom": "{{spacing_px.2}}px"
        }
      },
      {
        "selector": ".section-heading p",
        "declarations": {
          "font-size": "{{font_sizes_px.meta}}px",
          "color": "var(--muted)"
        }
      },
      {
        "selector": ".session-row",
        "declarations": {
          "display": "grid",
          "grid-template-columns": "130px 1fr auto",
          "gap": "{{spacing_px.4}}px",
          "align-items": "center",
          "padding": "{{spacing_px.5}}px 0",
          "border-top": "1px solid var(--line)"
        }
      },
      {
        "selector": ".session-date",
        "declarations": {
          "font-size": "16px",
          "font-weight": "{{fonts.display.weight}}"
        }
      },
      {
        "selector": ".session-date small",
        "declarations": {
          "display": "block",
          "font-size": "{{font_sizes_px.meta}}px",
          "color": "var(--muted)",
          "font-weight": "{{fonts.body.weight}}",
          "margin-top": "2px"
        }
      },
      {
        "selector": ".session-row h3 a",
        "declarations": {
          "text-decoration": "none"
        }
      },
      {
        "selector": ".session-row .summary",
        "declarations": {
          "font-size": "{{font_sizes_px.control}}px",
          "color": "var(--muted)",
          "margin": "6px 0 10px"
        }
      },
      {
        "selector": ".inline-meta",
        "declarations": {
          "display": "flex",
          "gap": "{{spacing_px.0}}px {{spacing_px.3}}px",
          "flex-wrap": "wrap",
          "font-size": "{{font_sizes_px.meta}}px",
          "color": "var(--muted)"
        }
      },
      {
        "selector": ".row-action",
        "declarations": {
          "text-align": "right"
        }
      },
      {
        "selector": ".row-action .price",
        "declarations": {
          "display": "block",
          "font-weight": "{{fonts.display.weight}}",
          "margin-bottom": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".row-action .button",
        "declarations": {
          "min-width": "128px"
        }
      },
      {
        "selector": ".split",
        "declarations": {
          "display": "grid",
          "grid-template-columns": "minmax(0,1.5fr) minmax(280px,1fr)",
          "gap": "{{spacing_px.8}}px"
        }
      },
      {
        "selector": ".paper",
        "declarations": {
          "padding": "{{spacing_px.6}}px",
          "background": "var(--cream)",
          "border": "1px solid var(--line)"
        }
      },
      {
        "selector": ".stack>*+*",
        "declarations": {
          "margin-top": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".prose",
        "declarations": {
          "white-space": "pre-line",
          "line-height": "2"
        }
      },
      {
        "selector": ".facts",
        "declarations": {
          "margin": "0"
        }
      },
      {
        "selector": ".facts>div",
        "declarations": {
          "display": "grid",
          "grid-template-columns": "100px 1fr",
          "gap": "{{spacing_px.2}}px",
          "padding": "14px 0",
          "border-bottom": "1px solid var(--line)"
        }
      },
      {
        "selector": ".facts dt",
        "declarations": {
          "color": "var(--muted)",
          "font-size": "{{font_sizes_px.meta}}px"
        }
      },
      {
        "selector": ".facts dd",
        "declarations": {
          "margin": "0"
        }
      },
      {
        "selector": ".total",
        "declarations": {
          "display": "flex",
          "justify-content": "space-between",
          "gap": "{{spacing_px.2}}px",
          "padding": "{{spacing_px.4}}px 0",
          "font-size": "{{font_sizes_px.subsection}}px",
          "font-weight": "{{fonts.display.weight}}",
          "border-top": "1px solid var(--ink)",
          "margin-top": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".field",
        "declarations": {
          "margin-bottom": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".field label",
        "declarations": {
          "display": "block",
          "font-size": "{{font_sizes_px.control}}px",
          "font-weight": "{{fonts.display.weight}}",
          "margin-bottom": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".field input:not([type=checkbox]):not([type=radio]),.field select,.field textarea",
        "declarations": {
          "display": "block",
          "width": "100%",
          "min-height": "{{controls.min_height}}px",
          "border": "1px solid var(--muted)",
          "border-radius": "{{controls.radius}}",
          "padding": "10px {{spacing_px.1}}px",
          "background": "var(--cream)",
          "color": "var(--ink)"
        }
      },
      {
        "selector": ".field textarea",
        "declarations": {
          "min-height": "120px"
        }
      },
      {
        "selector": ".field input[type=checkbox],.field input[type=radio]",
        "declarations": {
          "width": "20px",
          "height": "20px",
          "accent-color": "var(--rust)",
          "vertical-align": "middle",
          "margin": "0 10px 0 0"
        }
      },
      {
        "selector": ".field.check label",
        "declarations": {
          "min-height": "44px",
          "display": "flex",
          "align-items": "center"
        }
      },
      {
        "selector": ".field input[aria-invalid=true],.field select[aria-invalid=true]",
        "declarations": {
          "border": "2px solid var(--rust)"
        }
      },
      {
        "selector": ".help",
        "declarations": {
          "font-size": "{{font_sizes_px.meta}}px",
          "color": "var(--muted)",
          "margin-top": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".errorlist",
        "declarations": {
          "list-style": "none",
          "margin": "{{spacing_px.0}}px 0",
          "padding": "0",
          "color": "var(--rust)",
          "font-size": "{{font_sizes_px.meta}}px"
        }
      },
      {
        "selector": ".error-summary,.notice",
        "declarations": {
          "padding": "{{spacing_px.3}}px {{spacing_px.4}}px",
          "background": "var(--cream)",
          "border": "1px solid var(--line)",
          "margin-bottom": "{{spacing_px.4}}px"
        }
      },
      {
        "selector": ".error-summary",
        "declarations": {
          "border-color": "var(--rust)",
          "color": "var(--rust)"
        }
      },
      {
        "selector": ".notice.success",
        "declarations": {
          "color": "var(--green)",
          "border-color": "var(--green)"
        }
      },
      {
        "selector": ".notice p+p",
        "declarations": {
          "margin-top": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".badge",
        "declarations": {
          "display": "inline-block",
          "padding": "3px 10px",
          "border": "1px solid var(--line)",
          "font-size": "{{font_sizes_px.caption}}px",
          "line-height": "1.6",
          "background": "var(--cream)",
          "white-space": "nowrap"
        }
      },
      {
        "selector": ".badge.confirmed",
        "declarations": {
          "color": "var(--green)",
          "border-color": "var(--green)"
        }
      },
      {
        "selector": ".badge.waitlisted",
        "declarations": {
          "color": "var(--rust)",
          "border-color": "var(--rust)"
        }
      },
      {
        "selector": ".badge.cancelled",
        "declarations": {
          "color": "var(--muted)"
        }
      },
      {
        "selector": ".back",
        "declarations": {
          "display": "inline-flex",
          "align-items": "center",
          "min-height": "44px",
          "font-size": "{{font_sizes_px.meta}}px",
          "margin-bottom": "{{spacing_px.3}}px"
        }
      },
      {
        "selector": ".auth",
        "declarations": {
          "max-width": "480px",
          "margin": "auto"
        }
      },
      {
        "selector": ".auth h1",
        "declarations": {
          "font-size": "32px"
        }
      },
      {
        "selector": ".auth .paper",
        "declarations": {
          "margin-top": "{{spacing_px.5}}px"
        }
      },
      {
        "selector": ".auth-footer",
        "declarations": {
          "font-size": "{{font_sizes_px.control}}px",
          "margin-top": "{{spacing_px.4}}px",
          "text-align": "center"
        }
      },
      {
        "selector": ".empty",
        "declarations": {
          "padding": "{{spacing_px.8}}px {{spacing_px.4}}px",
          "border-top": "1px solid var(--line)",
          "border-bottom": "1px solid var(--line)"
        }
      },
      {
        "selector": ".empty p",
        "declarations": {
          "color": "var(--muted)",
          "margin-top": "10px"
        }
      },
      {
        "selector": ".booking-row",
        "declarations": {
          "display": "grid",
          "grid-template-columns": "1fr auto",
          "gap": "{{spacing_px.4}}px",
          "align-items": "center",
          "padding": "{{spacing_px.5}}px 0",
          "border-top": "1px solid var(--line)"
        }
      },
      {
        "selector": ".booking-row h3",
        "declarations": {
          "margin": "{{spacing_px.0}}px 0"
        }
      },
      {
        "selector": ".booking-row h3 a",
        "declarations": {
          "text-decoration": "none"
        }
      },
      {
        "selector": ".booking-id",
        "declarations": {
          "font-size": "{{font_sizes_px.caption}}px",
          "color": "var(--muted)",
          "overflow-wrap": "anywhere"
        }
      },
      {
        "selector": ".notification",
        "declarations": {
          "padding": "{{spacing_px.4}}px 0",
          "border-top": "1px solid var(--line)"
        }
      },
      {
        "selector": ".notification h2",
        "declarations": {
          "font-size": "{{font_sizes_px.subsection}}px"
        }
      },
      {
        "selector": ".notification p",
        "declarations": {
          "margin-top": "{{spacing_px.0}}px"
        }
      },
      {
        "selector": ".notification form",
        "declarations": {
          "margin-top": "{{spacing_px.2}}px"
        }
      },
      {
        "selector": ".staff-nav",
        "declarations": {
          "display": "flex",
          "gap": "{{spacing_px.4}}px",
          "border-bottom": "1px solid var(--line)",
          "margin": "-12px 0 {{spacing_px.6}}px",
          "overflow": "auto"
        }
      },
      {
        "selector": ".staff-nav a",
        "declarations": {
          "display": "inline-flex",
          "min-height": "{{controls.min_height}}px",
          "align-items": "center",
          "text-decoration": "none",
          "white-space": "nowrap",
          "font-size": "{{font_sizes_px.control}}px"
        }
      },
      {
        "selector": ".staff-nav a[aria-current=page]",
        "declarations": {
          "color": "var(--rust)",
          "box-shadow": "inset 0 -2px var(--rust)"
        }
      },
      {
        "selector": ".stats",
        "declarations": {
          "display": "grid",
          "grid-template-columns": "repeat(4,1fr)",
