    [],
    [
      {
        "comment": " Real inputs own interaction; adjacent DOM marks also survive editable design capture. "
      }
    ],
    [
      {
        "selector": ".choice-paint",
        "declarations": {
          "display": "inline-grid",
          "grid-template-columns": "20px",
