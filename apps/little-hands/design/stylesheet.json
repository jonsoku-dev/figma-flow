          "width": "20px",
          "height": "20px",
          "flex": "0 0 20px",
          "vertical-align": "middle",
          "margin-right": "10px"
        }
      }
    ],
    [
      {
        "selector": ".choice-paint>input.choice-input",
        "declarations": {
          "appearance": "none",
          "-webkit-appearance": "none",
          "display": "block",
          "grid-area": "1/1",
          "width": "20px",
          "height": "20px",
          "min-width": "20px",
          "min-height": "20px",
          "padding": "0",
          "margin": "0",
          "background": "var(--cream)",
          "border": "1px solid var(--muted)",
          "border-radius": "{{controls.radius}}",
          "cursor": "pointer",
          "opacity": "1"
