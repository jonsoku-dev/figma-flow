# Install in the host nginx http context after replacing workshop.example.invalid
# and certificate paths. The host is the only trusted proxy.
server {
    listen 80;
    server_name workshop.example.invalid;
    return 308 https://workshop.example.invalid$request_uri;
}
server {
    listen 443 ssl;
    server_name workshop.example.invalid;
    ssl_certificate /etc/letsencrypt/live/workshop.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/workshop.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8870;
        proxy_set_header Host workshop.example.invalid;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_http_version 1.1;
        proxy_read_timeout 35s;
    }
}
