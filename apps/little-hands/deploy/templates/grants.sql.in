\set ON_ERROR_STOP on
BEGIN;
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM {{cfg.database.runtime}};
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO {{cfg.database.runtime}};
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO {{cfg.database.runtime}};
REVOKE UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON booking_auditevent, booking_operation FROM {{cfg.database.runtime}};
REVOKE ALL ON django_migrations FROM {{cfg.database.runtime}};
COMMIT;
