FROM {{cfg.web.pythonImage}} AS python-dependencies
COPY requirements.lock /tmp/requirements.lock
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --prefix /opt/littlehands-python --require-hashes --only-binary=:all: --no-binary=mysqlclient -r /tmp/requirements.lock

FROM {{cfg.web.pythonImage}}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY --from=python-dependencies /opt/littlehands-python/ /usr/local/
RUN apt-get update && apt-get install -y --no-install-recommends libmariadb3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid {{cfg.web.uid}} littlehands \
    && useradd --uid {{cfg.web.uid}} --gid {{cfg.web.uid}} --no-create-home littlehands
COPY manage.py ./
COPY config/ config/
COPY booking/ booking/
COPY templates/ templates/
COPY static/ static/
COPY deploy/entrypoint.py deploy/healthcheck.py deploy/
RUN python -c 'import os,secrets; os.environ.update(LH_ENV="production", LH_SECRET_KEY=secrets.token_urlsafe(64), LH_ALLOWED_HOSTS="localhost", LH_SITE_URL="https://localhost"); from django.core.management import execute_from_command_line; os.environ["DJANGO_SETTINGS_MODULE"]="config.settings"; execute_from_command_line(["manage.py", "collectstatic", "--noinput"])'
USER {{cfg.web.uid}}:{{cfg.web.uid}}
EXPOSE {{cfg.web.internalPort}}
ENTRYPOINT ["python", "deploy/entrypoint.py"]
CMD ["gunicorn", "config.wsgi:application", "--bind=0.0.0.0:{{cfg.web.internalPort}}", "--workers=2", "--threads=2", "--timeout=30", "--worker-tmp-dir=/tmp", "--forwarded-allow-ips=", "--no-control-socket", "--error-logfile=-"]
