{
  "schema": "figma-flow-delivery-v1",
  "inputs": {
    "branch": "main",
    "actions": {
      "checkout": "3d3c42e5aac5ba805825da76410c181273ba90b1",
      "setup-python": "6d4fd22b20465ccc0f7354476588e8df7c9ca0e0",
      "setup-node": "949feb2413d6458794dcd2491c4babbbce0c15c1"
    },
    "python": "3.13",
    "nodeVersionFile": ".nvmrc",
    "typescript": {
      "source": "library/figma-api/package.json",
      "dependency": "typescript"
    },
    "sandboxCli": {
      "version": "0.165.0",
      "artifacts": {
        "arm64": {
          "target": "aarch64-apple-darwin",
          "sha256": "78ea9c178d2dc8fde71d6494df3b9eab902fd6d6de0a84e65234220d93bb6144"
        },
        "x86_64": {
          "target": "x86_64-apple-darwin",
          "sha256": "f46451741936ebdf5201b8becd0820a41be2a01d271b98703e0d9a1670c99993"
        }
      }
    },
    "panelInstall": "npm --prefix panel-ui install --ignore-scripts --no-package-lock --no-audit --no-fund",
    "appCi": {
      "root": "apps/little-hands",
      "user": "root",
      "disposablePassword": "disposable-ci-only",
      "deploymentSource": "apps/little-hands/config/deployment.json",
      "mysqlFormula": "mysql@8.4"
    },
    "nativeValidationRunner": "macos-15"
  },
  "workflows": {
    "little-hands": {
      "source": "library/delivery/little-hands.yml.in",
      "output": ".github/workflows/little-hands.yml"
    },
    "patch-knowledge": {
      "source": "library/delivery/patch-knowledge.yml.in",
      "output": ".github/workflows/patch-knowledge.yml"
    },
    "reference-guard": {
      "source": "library/delivery/reference-guard.yml.in",
      "output": ".github/workflows/reference-guard.yml"
    },
    "test": {
      "source": "library/delivery/test.yml.in",
      "output": ".github/workflows/test.yml"
    }
  },
  "native": {
    "marketplace": {
      "source": ".agents/plugins/marketplace.json",
      "plugin": "plugin.json",
      "localRoot": "./",
      "role": "Fork-owned marketplace identity and installation policy; local product name and category are projected from plugin.json."
    },
    "checkout": {
      "source": ".gitattributes",
      "role": "Preserve upstream bytes and the declared whitespace treatment across Git checkout."
    },
    "privateFiles": {
      "source": ".gitignore",
      "role": "Exclude private state, credentials, dependency artifacts and local reference material; allow the shared environment example."
    },
    "npm": {
      "source": ".npmrc",
      "role": "Project-local npm configuration suppresses package lock creation."
    },
    "node": {
      "source": ".nvmrc",
      "role": "The supported Node runtime for the panel and verification jobs."
    },
    "optionalPython": {
      "source": "requirements-optional.txt",
      "role": "Installer authority for optional Python dependencies used by the graph, raster, font and CSS consumers."
    }
  }
}
