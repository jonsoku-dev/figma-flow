name: Reference distribution guard
on:
  push:
    branches: [{{delivery.branch}}]
    tags: ['v*']
  pull_request:
permissions:
  contents: read
jobs:
  guard:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@{{delivery.actions.checkout}}
        with:
          fetch-depth: 0
      - uses: actions/setup-python@{{delivery.actions.setup-python}}
        with:
          python-version: '{{delivery.python}}'
      - uses: actions/setup-node@{{delivery.actions.setup-node}}
        with:
          node-version-file: {{delivery.nodeVersionFile}}
      - name: Prepare panel build dependencies for post-0.x archive verification
        run: |
          if node -e "process.exit(Number(require('./plugin.json').version.split('.')[0]) > 0 ? 0 : 1)"; then
            {{delivery.panelInstall}}
          fi
      - name: Verify manifest projection and release gate behavior
        run: |
          python -B tools/plugin_manifest.py
          python -B tools/delivery_config.py
          python -B -m unittest tests.test_major_release tests.test_major_policy_boundary tests.test_spec_graph_coverage
      - name: Run synthetic guard behavior tests
        run: python -B -m unittest -v tests.test_reference_distribution_guard
      - name: Verify pinned external skill dependencies
        run: python -B tools/skill_dependencies.py --check
      - name: Check tracked ref paths and ephemeral evidence (paths-only; no local reference lists)
        run: python -B tools/reference_distribution_guard.py --ref HEAD --format text
      - name: Check version and SSOT before packaging this Git tree
        env:
          RELEASE_REF: ${{ github.ref_type == 'tag' && github.ref_name || github.sha }}
          PREVIOUS_REF: ${{ github.event.pull_request.base.sha || github.event.before }}
        shell: bash
        run: |
          base_args=()
          if [[ -n "$PREVIOUS_REF" && ! "$PREVIOUS_REF" =~ ^0+$ ]]; then
            base_args=(--base-ref "$PREVIOUS_REF")
          fi
          python -B tools/major_release.py --if-major --ref "$RELEASE_REF" "${base_args[@]}" --archive "$RUNNER_TEMP/dist-check.zip"
          python -B tools/reference_distribution_guard.py --target-zip "$RUNNER_TEMP/dist-check.zip" --format text
