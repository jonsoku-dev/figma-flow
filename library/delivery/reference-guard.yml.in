name: Reference distribution guard
on:
  push:
    branches: [{{delivery.branch}}]
    tags: ['v*']
  pull_request:
permissions:
  contents: read
jobs:
  guard:
    runs-on: {{delivery.nativeValidationRunner}}
    steps:
      - uses: actions/checkout@{{delivery.actions.checkout}}
        with:
          fetch-depth: 0
      - uses: actions/setup-python@{{delivery.actions.setup-python}}
        with:
          python-version: '{{delivery.python}}'
      - uses: actions/setup-node@{{delivery.actions.setup-node}}
        with:
          node-version-file: {{delivery.nodeVersionFile}}
      - name: Prepare dependencies for the post-0.x archive witnesses
        run: |
          if node -e "process.exit(Number(require('./plugin.json').version.split('.')[0]) > 0 ? 0 : 1)"; then
            {{delivery.panelInstall}}
            python -m pip install -r requirements-optional.txt -r library/figma-rest/requirements.txt
            brew install {{delivery.appCi.mysqlFormula}} pkgconf
            mysql_prefix="$(brew --prefix {{delivery.appCi.mysqlFormula}})"
            PKG_CONFIG_PATH="$mysql_prefix/lib/pkgconfig" python -m pip install --require-hashes --only-binary=:all: --no-binary=mysqlclient -r {{delivery.appCi.root}}/requirements.lock
            npm install --prefix "$RUNNER_TEMP/figma-api-tools" --ignore-scripts --no-audit --no-fund --no-package-lock typescript@{{delivery.typescript}}
            echo "FIGMA_API_TYPESCRIPT=$RUNNER_TEMP/figma-api-tools/node_modules/typescript/lib/typescript.js" >> "$GITHUB_ENV"
            echo "FIGMA_SDK_TEST_TYPESCRIPT=$RUNNER_TEMP/figma-api-tools/node_modules/typescript/lib/tsc.js" >> "$GITHUB_ENV"
            mkdir -p "$RUNNER_TEMP/figma-flow-codex"
            target={{delivery.sandboxCli.artifacts.arm64.target}}
            archive="$RUNNER_TEMP/figma-flow-codex/codex.tar.gz"
            curl --fail --location --retry 3 --output "$archive" "https://github.com/openai/codex/releases/download/rust-v{{delivery.sandboxCli.version}}/codex-${target}.tar.gz"
            echo "{{delivery.sandboxCli.artifacts.arm64.sha256}}  $archive" | shasum -a 256 -c -
            tar -xzf "$archive" -C "$RUNNER_TEMP/figma-flow-codex" "codex-${target}"
            mv "$RUNNER_TEMP/figma-flow-codex/codex-${target}" "$RUNNER_TEMP/figma-flow-codex/codex"
            echo "$RUNNER_TEMP/figma-flow-codex" >> "$GITHUB_PATH"
            fixture="$RUNNER_TEMP/figma-flow-mysql"
            mkdir "$fixture"
            echo "LH_CI_MYSQL_PREFIX=$mysql_prefix" >> "$GITHUB_ENV"
            echo "LH_CI_MYSQL_SOCKET=$fixture/mysql.sock" >> "$GITHUB_ENV"
            mysql_port=$(python -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
            "$mysql_prefix/bin/mysqld" --no-defaults --initialize-insecure --datadir="$fixture/data"
            "$mysql_prefix/bin/mysqld" --no-defaults --daemonize --datadir="$fixture/data" \
              --socket="$fixture/mysql.sock" --pid-file="$fixture/mysql.pid" --log-error="$fixture/mysql.log" \
              --bind-address=127.0.0.1 --port="$mysql_port" --mysqlx=OFF --log-bin-trust-function-creators=ON
            "$mysql_prefix/bin/mysql_tzinfo_to_sql" /usr/share/zoneinfo |
              "$mysql_prefix/bin/mysql" --no-defaults --protocol=socket --socket="$fixture/mysql.sock" --user=root mysql
            "$mysql_prefix/bin/mysql" --no-defaults --protocol=socket --socket="$fixture/mysql.sock" --user=root \
              -e "ALTER USER 'root'@'localhost' IDENTIFIED BY '{{delivery.appCi.disposablePassword}}';"
            echo "FIGMA_FLOW_MYSQL_TEST_HOST=127.0.0.1" >> "$GITHUB_ENV"
            echo "FIGMA_FLOW_MYSQL_TEST_PORT=$mysql_port" >> "$GITHUB_ENV"
            echo "FIGMA_FLOW_MYSQL_TEST_PASSWORD={{delivery.appCi.disposablePassword}}" >> "$GITHUB_ENV"
            echo "FIGMA_FLOW_ARCHIVE_VALIDATION=1" >> "$GITHUB_ENV"
          fi
      - name: Verify manifest projection and release gate behavior
        run: |
          python -B tools/plugin_manifest.py
          python -B tools/delivery_config.py
          python -B -m unittest tests.test_major_release tests.test_major_policy_boundary tests.test_spec_graph_coverage
      - name: Run synthetic guard behavior tests
        run: python -B -m unittest -v tests.test_reference_distribution_guard
      - name: Verify pinned external skill dependencies
        run: python -B tools/skill_dependencies.py --check
      - name: Check tracked ref paths and ephemeral evidence (paths-only; no local reference lists)
        run: python -B tools/reference_distribution_guard.py --ref HEAD --format text
      - name: Run the release graph mutation checks
        run: python -B tools/maintenance.py verify --profile release --out "$RUNNER_TEMP/figma-flow-graph-evidence"
      - name: Check packaged app quality and relay transport
        if: env.FIGMA_FLOW_ARCHIVE_VALIDATION == '1'
        run: |
          python -B apps/little-hands/design/prepare_fonts.py
          quality="$RUNNER_TEMP/figma-flow-app-quality.json"
          trap 'rm -f "$quality"' EXIT
          if ! python -B tools/design_quality.py --layout apps/little-hands/design/native-layout.json --out "$quality" >/dev/null; then
            python -c 'import json,sys; report=json.load(open(sys.argv[1])); print(report["summary"]); print(report["errors"][:6])' "$quality"
            exit 1
          fi
          python -B -m unittest -v tests.test_control_transport_authority
      - name: Check version and SSOT before packaging this Git tree
        env:
          RELEASE_REF: ${{ github.ref_type == 'tag' && github.ref_name || github.sha }}
          PREVIOUS_REF: ${{ github.event.pull_request.base.sha || github.event.before }}
        shell: bash
        run: |
          base_args=()
          if [[ -n "$PREVIOUS_REF" && ! "$PREVIOUS_REF" =~ ^0+$ ]]; then
            base_args=(--base-ref "$PREVIOUS_REF")
          fi
          python -B tools/major_release.py --if-major --ref "$RELEASE_REF" "${base_args[@]}" --archive "$RUNNER_TEMP/dist-check.zip"
          python -B tools/reference_distribution_guard.py --target-zip "$RUNNER_TEMP/dist-check.zip" --format text
          shasum -a 256 "$RUNNER_TEMP/dist-check.zip"
      - name: Remove the run-owned archive and test database
        if: always()
        run: |
          rm -f "$RUNNER_TEMP/dist-check.zip"
          if [[ -n "$LH_CI_MYSQL_SOCKET" && -S "$LH_CI_MYSQL_SOCKET" ]]; then
            MYSQL_PWD="{{delivery.appCi.disposablePassword}}" "$LH_CI_MYSQL_PREFIX/bin/mysqladmin" --no-defaults \
              --protocol=socket --socket="$LH_CI_MYSQL_SOCKET" --user=root shutdown ||
              "$LH_CI_MYSQL_PREFIX/bin/mysqladmin" --no-defaults --protocol=socket \
                --socket="$LH_CI_MYSQL_SOCKET" --user=root shutdown
          fi
          rm -rf "$RUNNER_TEMP/figma-flow-mysql"
