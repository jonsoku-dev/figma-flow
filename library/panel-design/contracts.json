      "type": "projected by",
      "to": "workspace-asset-list"
    },
    {
      "from": "operation-detail-v1",
      "type": "normalized by",
      "to": "workspace-operation-detail"
    },
    {
      "from": "chat-error-codes",
      "type": "localized by",
