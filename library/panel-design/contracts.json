{
  "schema": "figma-flow-panel-contract-graph-v1",
  "version": 1,
  "id": "panel-domain-contracts",
  "nodes": [
    {
      "id": "dependency-artifacts",
      "type": "allowlist",
      "title": "Workspace task dependency output files",
      "status": "observed",
      "relation": "uses-output",
      "directions": ["predecessor", "successor"],
      "values": [
        "code.js",
        "ui.html",
        "manifest.json"
      ],
      "taskArtifactFiles": {
        "sync": "native-plan.json",
        "native-edit": "native-edit-plan.json",
        "import": "reviewed-payload.json",
        "review": "packet.json"
      }
    },
    {
      "id": "asset-inventory-statuses",
      "type": "allowlist",
      "title": "Workspace input asset status display",
      "status": "observed",
      "statuses": [
        {
          "value": "present",
          "severity": "informational"
        },
        {
          "value": "404",
          "severity": "problem"
        },
        {
          "value": "rejected",
          "severity": "problem"
        },
        {
          "value": "external-unverified",
          "severity": "problem"
        }
      ]
    },
    {
      "id": "operation-detail-v1",
      "type": "protocol",
      "title": "Read-only operation detail DTO v1",
      "status": "observed",
      "schema": "figma-flow-operation-detail-v1",
      "protocol": {
        "requestType": "workspace-history-detail",
        "resultType": "workspace-history-detail-result",
        "scopeChangedType": "workspace-scope-changed"
      },
      "classifications": [
        "recorded",
        "legacy",
        "unknown"
      ],
      "resultStatuses": [
        "ok",
        "unavailable",
        "scope-changed",
        "error"
      ],
      "operationStates": [
        "pending",
        "claimed",
        "ok",
        "error",
        "uncertain",
        "expired"
      ],
      "nativePhases": [
        "queued",
        "claimed",
        "native-started",
        "result-received",
        "reconciled",
        "uncertain"
      ],
      "displayPhaseFallbacks": [
        "unknown"
      ],
      "relationTypes": [
        "declared-dependency",
        "recovery-of",
        "artifact-input"
      ],
      "relationDirections": {
        "declared-dependency": [
          "predecessor",
          "successor"
        ],
        "recovery-of": [
          "recovers",
          "recovered-by"
        ]
      },
      "revisionBindings": [
        "current",
        "pinned-historical",
        "retired",
        "orphan",
        "unknown"
      ],
      "diffStatuses": [
        "available",
        "empty",
        "unavailable"
      ],
      "diffKinds": [
        "changed",
        "added",
        "removed",
        "type-changed"
      ],
      "failureCodes": [
        "native-conflict",
        "result-rejected",
        "claim-expired",
        "operation-uncertain",
        "execution-failed"
      ],
      "failureActions": [
        "inspect-conflicts",
        "run-native-read",
        "reopen-plugin",
        "inspect-private-status"
      ],
      "failureSummaryByCase": {
        "noFailureStates": [
          "ok",
          "pending",
          "claimed"
        ],
        "expired": {
          "code": "claim-expired",
          "action": "inspect-private-status"
        },
        "uncertain": {
          "code": "operation-uncertain",
          "action": "run-native-read"
        },
        "conflict": {
          "code": "native-conflict",
          "action": "inspect-conflicts"
        },
        "rejected": {
          "code": "result-rejected",
          "action": "reopen-plugin"
        },
        "default": {
          "code": "execution-failed",
          "action": "inspect-private-status"
        }
      },
      "hostOperations": [
        "read",
        "import",
        "sync",
        "create",
        "apply"
      ],
      "fallbacks": {
        "unknown": "unknown",
        "unavailable": "unavailable",
        "uncertain": "uncertain",
        "beforeArtifactMissing": "before-artifact-missing"
      },
      "scopeNotices": {
        "exact": "read-only-exact-scope",
        "truncated": "read-only-truncated-256kib",
        "diffFieldsCapped": "read-only-diff-capped-at-200-fields"
      },
