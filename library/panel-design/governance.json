    "tests/test_panel_maintenance_boundary.cjs": [
      "panel build flags transport and native bridge bypasses",
      "review pairing posts only the approved payload to the prepared local receiver"
    ],
    "tests/test_panel_contract_ownership.cjs": [
      "all authored panel CSS dimensions have graph tokens and an injected literal is detected",
      "graph preview metrics and workspace activity enums are projected from their field owners",
      "cross-language panel contract graph owns operation detail, dependency artifact and asset status enums",
      "React chat input bounds and row counts derive from the shared host contract graph",
      "operation detail producer imports in a fresh process with the canonical domain graph",
      "token projection mutation fails closed when an authoritative dimension changes"
    ]
