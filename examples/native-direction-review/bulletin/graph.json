        "state-bulletin-overview"
      ],
      "annotation": {
        "control_id": "bulletin-back",
        "purpose": "Let visitors inspect the example and keep their place in the overview.",
        "behavior": "Return to the workshop overview.",
        "result": "The overview becomes visible again.",
        "failure": "No form data, registration, account or payment is created.",
        "functional_states": [
          "state-bulletin-overview",
          "state-bulletin-details"
        ],
