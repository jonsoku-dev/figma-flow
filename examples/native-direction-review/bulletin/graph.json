      "type": "screen",
      "title": "Welcome board",
      "annotation": {
        "purpose": "Introduce the community workshop and its session overview.",
        "journey": "Read the introduction, inspect session details, then return without registering.",
        "first_action": "action-bulletin-open",
        "failure": "This is a local demo; it never creates a registration."
      },
      "status": "planned"
    },
    {
      "id": "screen-bulletin-details",
      "type": "screen",
      "title": "Session details",
