        "purpose": "Show the sample session information in a readable detail view.",
        "journey": "Read the sample information and return to the workshop overview.",
        "first_action": "action-bulletin-back",
        "failure": "The sample has no booking, payment or account functionality."
      },
      "status": "planned"
    },
