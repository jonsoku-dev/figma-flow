      "id": "state-bulletin-overview",
      "type": "state",
      "title": "Workshop overview visible",
      "status": "planned"
    },
    {
      "id": "state-bulletin-details",
      "type": "state",
      "title": "Sample session details visible",
      "status": "planned"
    },
